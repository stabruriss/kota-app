[
  {
    "name": "sequence breaks an exact timestamp tie",
    "messages": [
      {
        "id": "a-assistant-hash",
        "timestamp": "2026-07-27T10:00:00Z",
        "violetSeq": 42
      },
      {
        "id": "z-user-hash",
        "timestamp": "2026-07-27T10:00:00Z",
        "violetSeq": 41
      }
    ],
    "expectedIds": [
      "z-user-hash",
      "a-assistant-hash"
    ]
  },
  {
    "name": "sequence resolves overlapping timestamp precision",
    "messages": [
      {
        "id": "provider-reply",
        "timestamp": "2026-08-20T21:31:45+00:00",
        "violetSeq": 1474
      },
      {
        "id": "agent-bus-prompt",
        "timestamp": "2026-08-20T21:31:45.085001+00:00",
        "violetSeq": 1473
      }
    ],
    "expectedIds": [
      "agent-bus-prompt",
      "provider-reply"
    ]
  },
  {
    "name": "timestamp remains authoritative outside a tie",
    "messages": [
      {
        "id": "later",
        "timestamp": "2026-07-27T10:00:00.200Z",
        "violetSeq": 1
      },
      {
        "id": "earlier",
        "timestamp": "2026-07-27T10:00:00.100Z",
        "violetSeq": 999
      }
    ],
    "expectedIds": [
      "earlier",
      "later"
    ]
  },
  {
    "name": "a coarse second uses one transitive sequence order",
    "messages": [
      {
        "id": "precise-sequence-three",
        "timestamp": "2026-08-20T21:31:45.100Z",
        "violetSeq": 3
      },
      {
        "id": "coarse-sequence-two",
        "timestamp": "2026-08-20T21:31:45Z",
        "violetSeq": 2
      },
      {
        "id": "precise-sequence-one",
        "timestamp": "2026-08-20T21:31:45.200Z",
        "violetSeq": 1
      }
    ],
    "expectedIds": [
      "precise-sequence-one",
      "coarse-sequence-two",
      "precise-sequence-three"
    ]
  },
  {
    "name": "legacy messages use sequence zero and stable id fallback",
    "messages": [
      {
        "id": "z-new",
        "timestamp": "2026-07-27T10:00:00Z",
        "violetSeq": 1
      },
      {
        "id": "z-legacy",
        "timestamp": "2026-07-27T10:00:00Z"
      },
      {
        "id": "a-legacy",
        "timestamp": "2026-07-27T10:00:00Z"
      }
    ],
    "expectedIds": [
      "a-legacy",
      "z-legacy",
      "z-new"
    ]
  }
]
