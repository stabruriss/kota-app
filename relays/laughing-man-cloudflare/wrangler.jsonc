{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kota-laughing-man-standby",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_STATE",
        "class_name": "RelayState"
      },
      {
        "name": "BBS_GROUP",
        "class_name": "BbsGroup"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayState"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["BbsGroup"]
    }
  ]
}
